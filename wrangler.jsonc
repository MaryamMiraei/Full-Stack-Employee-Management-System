{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "quick-esm-employee-management-system",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-11-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS",
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "quick-esm-employee-management-system",
		},
	],
	"vars": {
		"JWT_EXPIRES_IN": "24h",
		"ATTENDANCE_TIME_ZONE": "Asia/Tehran",
		"ATTENDANCE_START_TIME": "09:00",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "quick-esm-db",
			"database_id": "72f5b232-c5e5-4be0-a89d-7e7aaabd2a63"
		}
	],
}